<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Debug builds only: lets `adb shell am broadcast` add steps without walking. -->
        <receiver
            android:name=".debug.DebugStepsReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="app.pedometer.DEBUG_ADD_STEPS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
