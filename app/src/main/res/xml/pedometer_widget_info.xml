<?xml version="1.0" encoding="utf-8"?>
<!-- One row tall; added at 2 x 1 and resizable horizontally from 1 to 4 cells.
     minWidth is 2 cells by the pre-Android 12 formula (70n - 30); on 12+ the target
     cell size and maxResizeWidth (4 cells by 73n - 16) apply instead. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="276dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
